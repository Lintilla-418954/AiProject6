{
  "name": "vim-station",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "validate:content": "node tools/validate-content.ts --replay",
    "verify:oracle": "node tools/oracle/verify.ts",
    "verify:solver": "node tools/solver/verify.ts",
    "verify:examples": "node spec/verify-examples.ts",
    "check": "npm run typecheck && npm test && npm run validate:content && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prototype:scene": "vite prototype/scene-binding",
    "prototype:solver": "node prototype/solver/bench.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
